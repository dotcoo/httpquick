{
  "name": "httpquick",
  "version": "1.2.3",
  "description": "js http quick request",
  "author": "dotcoo <dotcoo@163.com> (http://blog.dotcoo.com)",
  "homepage": "https://github.com/dotcoo/httpquick#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotcoo/httpquick.git"
  },
  "license": "ISC",
  "keywords": [
    "http",
    "quick",
    "request"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "types.d.ts"
  ],
  "type": "module",
  "main": "./dist/httpquick-ajax.umd.js",
  "exports": {
    ".": {
      "types": "./dist/httpquick.d.ts",
      "import": "./dist/httpquick-ajax.js",
      "require": "./dist/httpquick-ajax.cjs",
      "browser": "./dist/httpquick-ajax.umd.js"
    },
    "./ajax": {
      "types": "./dist/httpquick.d.ts",
      "import": "./dist/httpquick-ajax.js",
      "require": "./dist/httpquick-ajax.cjs",
      "browser": "./dist/httpquick-ajax.umd.js"
    },
    "./fetch": {
      "types": "./dist/httpquick.d.ts",
      "import": "./dist/httpquick-fetch.js",
      "browser": "./dist/httpquick-fetch.umd.js"
    },
    "./uniapp": {
      "types": "./dist/httpquick.d.ts",
      "import": "./dist/httpquick-uniapp.js"
    },
    "./xcx": {
      "types": "./dist/httpquick.d.ts",
      "import": "./dist/httpquick-xcx.js"
    },
    "./node": {
      "types": "./dist/httpquick.d.ts",
      "import": "./dist/httpquick-node.js",
      "require": "./dist/httpquick-node.cjs"
    },
    "./fibjs": {
      "types": "./dist/httpquick.d.ts",
      "import": "./dist/httpquick-fibjs.js",
      "require": "./dist/httpquick-fibjs.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode=es && vite build --mode=cjs --emptyOutDir=false && vite build --mode=umd --emptyOutDir=false",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/language-core": "^3.3.4",
    "pinia": "^3.0.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  }
}
